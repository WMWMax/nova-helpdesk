# ОБРАЗЕЦ файла с секретами.
#
# Как пользоваться (один раз при первом запуске проекта):
#   Windows:      copy .env.example .env
#   Linux / Mac:  cp .env.example .env
# Затем впишите реальные значения вместо подсказок ниже.

# Главный ключ Django. Сгенерировать новый можно так:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=вставьте-сюда-длинный-случайный-ключ

# Режим отладки: True для локальной разработки, False на боевом сервере
DEBUG=True

# Разрешённые домены (через запятую)
ALLOWED_HOSTS=127.0.0.1,localhost

# Почтовый сервер
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=пароль-от-почты